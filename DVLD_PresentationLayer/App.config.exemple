<?xml version="1.0" encoding="utf-8" ?>
<configuration>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <connectionStrings>
        <add name="ConnectionString"
             connectionString="Server=.;Database=DVLD;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>

    <appSettings>
        <add key="EmailFrom" value="YOUR_EMAIL" />
        <add key="EmailAppPassword" value="YOUR_APP_PASSWORD" />
        <add key="EmailDisplayName" value="DVLD System" />
    </appSettings>

</configuration>